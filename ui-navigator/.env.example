# Google Cloud
GCP_PROJECT_ID=your-project-id
GOOGLE_API_KEY=your-gemini-api-key

# Firestore
FIRESTORE_DATABASE=(default)

# Cloud Storage
GCS_BUCKET=ui-navigator-artifacts

# Target
TARGET_URL=https://www.saucedemo.com
TARGET_PLATFORM=web

# Agent config
DEDUP_REPRESENTATIVES=2
ACTION_RETRY_LIMIT=3
MAX_ITERATIONS=50

# Models
GEMINI_PRO_MODEL=gemini-2.5-pro-preview-06-05
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_LITE_MODEL=gemini-2.0-flash-lite
